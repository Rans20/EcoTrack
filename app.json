{
  "expo": {
    "name": "EcoTrack",
    "slug": "ecotrack",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "EcoTrack: Track CO2 emissions, get sustainable route suggestions, and compete on city leaderboards.",
    "owner": "ecotrack",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecotrack.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EcoTrack uses location to suggest shorter routes and detect traffic on your map."
      }
    },
    "android": {
      "package": "com.ecotrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    }
  }
}
